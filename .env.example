# Copia este archivo como .env y llena los valores.
# NUNCA subas .env al repositorio. Pide los valores al owner del proyecto.

# Expo Router: desactiva el aviso de paquetes de navegación (npm start ya la define)
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=

# Firebase (se llenarán en la fase de Firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=